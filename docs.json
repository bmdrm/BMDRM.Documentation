{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "BMDRM",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#5B21B6"
  },
  "favicon": {
    "light": "/images/android-chrome-192x192.png",
    "dark": "/images/android-chrome-192x192.png"
  },
  "navigation": {
    "groups": [
      {
        "group": "BMDRM",
        "pages": [
          "introduction",
          "quickstart",
          "authentication",
          "faq"
        ]
      },
      {
        "group": "Features",
        "pages": [
          {
            "group": "Encoding",
            "pages": [
              "encoding/standard-encoding",
              "encoding/adaptive-bitrate-streaming"
            ]
          }
        ]
      },
      {
        "group": "Manage Videos",
        "pages": [
          {
            "group": "Upload",
            "pages": [
              "upload/multipart"
            ]
          },
          {
            "group": "Streaming",
            "pages": [
              "session-creation"
            ]
          }
        ]
      },
      {
        "group": "Accounts",
        "pages": [
          "accounts/appearance"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/transparent-image.png",
    "dark": "/images/converted-smart.png",
    "href": "https://bmdrm.com/"
  },
  "navbar": {
    "links": [
      {
        "href": "https://github.com/bmdrm",
        "label": "GitHub"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://dev.bmdrm.com/en/register"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "light"
  }
}
